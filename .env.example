# ===========================================
# FastAPI Starter Template Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Generate a secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ===========================================
# Core Settings
# ===========================================
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./app.db
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# Email Settings (Resend)
# ===========================================
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxx_your_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your App Name
RESET_URL_BASE=http://localhost:8000/reset

# Optional: Webhook verification for email events
RESEND_WEBHOOK_SECRET=

# ===========================================
# Logging Settings
# ===========================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true

# ===========================================
# LLM / OpenAI Settings (Optional)
# ===========================================
# Get your API key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
